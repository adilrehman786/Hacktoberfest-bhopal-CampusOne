{
  "name": "campusone",
  "private": true,
  "version": "1.0.0",
  "description": "CampusOne — Everything on campus. One place. AI-powered campus information hub.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env server/server.js",
    "dev:server:watch": "node --env-file-if-exists=.env --watch-path=server server/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/server.js",
    "preview": "vite build && npm start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "lucide-react": "^1.66.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
